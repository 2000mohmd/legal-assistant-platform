# Copy to .env.local (gitignored). These values are CONFIRMED correct for
# an unmodified local `supabase/config.toml` — verified by actually running
# `supabase start` and checking what it prints, not assumed (an earlier
# version of this file guessed wrong: real local Supabase generates a
# different default anon key than the widely-circulated "well-known" one
# from Supabase's own docs/tutorials). For a real Supabase Cloud project
# instead, replace both with the values from Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Optional — points chat at the real Python backend (../src/mizan/api)
# instead of the fixture lookup. Left commented out on purpose: this is
# the frontend-side switch for the same gold-set-review gate that keeps
# document generation off — see ../README.md "Wiring the frontend to this
# backend". Verified working when set. Both must be uncommented together
# and MIZAN_BACKEND_API_KEY must exactly match MIZAN_INTERNAL_API_KEY on
# the backend process (uv run uvicorn mizan.api.main:app --port 8000) —
# the backend fails closed (401/500) without a matching key, since CORS
# alone doesn't stop a direct server-to-server call.
# MIZAN_BACKEND_URL=http://127.0.0.1:8000
# MIZAN_BACKEND_API_KEY=local-dev-only-not-a-real-secret
